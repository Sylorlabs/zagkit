fn linux_preview_composition_build_with_interaction_state(
    width: i32, height: i32, face: OpenTypeFace,
    selected_navigation: i32, segmented_model: SegmentedControlModel,
    token_inspector_open: i32, interaction: LinuxPreviewInteractionState)
    LinuxPreviewCompositionArtifact {
