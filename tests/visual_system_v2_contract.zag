@import("../src/design/visual_system_v2.zag")
@import("../src/render/cpu_raster.zag")
@import("../src/render/display_list_codec.zag")

struct TestState { passed: i32, failed: i32 }

fn expect(state: *TestState, condition: i32, name: []u8) void {
    if (condition != 0) {
        state.*.passed = state.*.passed + 1;
        _zag_print("ok  "); _zag_println(name);
    } else {
        state.*.failed = state.*.failed + 1;
        _zag_print("FAIL "); _zag_println(name);
    }
}

fn pixel(surface: CpuSurface, x: i32, y: i32, channel: i32) i64 {
    return surface.pixels.data[(y * surface.width + x) * 4 + channel] as i64;
}

fn material_contract(state: *TestState) void {
    let standard: VisualEnvironment = visual_environment(FlexDensity.standard);
    let compact: VisualEnvironment = visual_environment(FlexDensity.compact);
    let panel: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.content_panel, VisualMaterialRole.automatic,
        SemanticElevationToken.panel, standard);
    let card: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.raised_card, VisualMaterialRole.automatic,
        SemanticElevationToken.raised, standard);
    let chrome: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.floating_chrome, VisualMaterialRole.automatic,
        SemanticElevationToken.panel, standard);
    let compact_chrome: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.floating_chrome, VisualMaterialRole.automatic,
        SemanticElevationToken.panel, compact);
    let overlay: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.transient_overlay, VisualMaterialRole.automatic,
        SemanticElevationToken.overlay, standard);

    expect(state, panel.effective_role == VisualMaterialRole.solid &&
        panel.fill_token == SemanticColorToken.surface_panel &&
        panel.material_token == SemanticMaterialToken.solid,
        "content panels remain solid while preserving panel luminance");
    expect(state, card.effective_role == VisualMaterialRole.solid &&
        card.fill_token == SemanticColorToken.surface_raised &&
        card.radius_token == SemanticRadiusToken.card,
        "raised cards use elevation without pretending to be translucent");
    expect(state, chrome.effective_role == VisualMaterialRole.veil &&
        chrome.blur_radius == 20 * unit_scale() &&
        chrome.tint_alpha > 0,
        "floating chrome resolves to bounded veil material");
    expect(state, compact_chrome.effective_role == VisualMaterialRole.solid &&
        compact_chrome.blur_radius == 0,
        "compact density demotes persistent veil to efficient solid chrome");
    expect(state, overlay.effective_role == VisualMaterialRole.glass &&
        overlay.blur_radius == 36 * unit_scale() &&
        visual_text_contrast_floor(overlay.effective_role) == 7000,
        "transient overlays alone receive full glass treatment and stronger contrast");

    let reduced: VisualEnvironment = standard;
    reduced.transparency = VisualTransparency.reduced;
    let reduced_overlay: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.transient_overlay, VisualMaterialRole.automatic,
        SemanticElevationToken.overlay, reduced);
    expect(state, reduced_overlay.effective_role == VisualMaterialRole.solid &&
        reduced_overlay.blur_radius == 0 && reduced_overlay.tint_alpha == 0,
        "reduced transparency is a deterministic material demotion");

    let high: VisualEnvironment = standard;
    high.high_contrast = 1;
    let high_chrome: VisualSurfaceEffects = visual_surface_effects(
        VisualSurfaceKind.floating_chrome, VisualMaterialRole.automatic,
        SemanticElevationToken.panel, high);
    expect(state, high_chrome.effective_role == VisualMaterialRole.solid,
        "high contrast removes variable translucent backdrops");

    let shadows: VisualShadowPair = visual_shadow_pair(
        SemanticElevationToken.raised);
    expect(state, shadows.contact.offset_x > 0 &&
        shadows.contact.offset_y > shadows.contact.offset_x &&
        shadows.ambient.blur_radius > shadows.contact.blur_radius &&
        shadows.ambient.alpha < shadows.contact.alpha,
        "one scene light derives coherent contact and ambient shadows");
    expect(state, visual_veil_area_budget(size(1200 * unit_scale(),
  800 * unit_scale())) == 240000 &&
        visual_glass_layer_budget() == 1,
        "veil area and glass-layer work remain explicitly bounded");
}

fn shadow_scene() DisplayList {
    let list: DisplayList = display_list_make();
    let shadow: DisplayOp = display_op(
        DisplayOpKind.fill_rounded_shadow, node_key(700));
    shadow.bounds = rect(10 * unit_scale(), 10 * unit_scale(),
        20 * unit_scale(), 20 * unit_scale());
    shadow.parameter = 6 * unit_scale();
    shadow.paint = paint_rgba16(0, 0, 0, 36000);
    shadow.paint.stroke_width = 6 * unit_scale();
    _ = display_list_push(&list, shadow);

    let fill: DisplayOp = display_op(
        DisplayOpKind.fill_rounded_rect, node_key(700));
    fill.bounds = shadow.bounds;
    fill.parameter = shadow.parameter;
    fill.paint = paint_rgba16(56000, 58000, 62000, 65535);
    _ = display_list_push(&list, fill);
    _ = display_list_seal(&list);
    return list;
}

fn analytic_shadow_contract(state: *TestState) void {
    let list: DisplayList = shadow_scene();
    let first: CpuRasterResult = cpu_rasterize(list, 40, 40);
    let second: CpuRasterResult = cpu_rasterize(list, 40, 40);
    expect(state, first.error == CpuRasterError.none &&
        first.rendered_ops == 2 && first.pixels_touched > 400,
        "CPU oracle executes analytic rounded shadows as bounded display work");
    expect(state, pixel(first.surface, 20, 20, 3) == 255 &&
        pixel(first.surface, 20, 34, 3) > 0 &&
        pixel(first.surface, 20, 34, 3) < 255 &&
        pixel(first.surface, 20, 39, 3) == 0,
        "shadow falloff is soft near the surface and reaches exact zero outside support");
    expect(state, cpu_surface_hash(first.surface) ==
        cpu_surface_hash(second.surface),
        "analytic shadow pixels are deterministic across identical renders");

    let encoded: DisplayEncodeResult = display_list_encode(list);
    let decoded: DisplayDecodeResult = display_list_decode(encoded.bytes);
    expect(state, encoded.error == DisplayCodecError.none &&
        decoded.error == DisplayCodecError.none &&
        decoded.list.ops.data[0].kind == DisplayOpKind.fill_rounded_shadow &&
        decoded.list.ops.data[0].paint.stroke_width == 6 * unit_scale(),
        "display-list transport preserves shadow kind radius blur and identity");

    display_decode_free(&decoded);
    display_encode_free(&encoded);
    cpu_raster_free(&second);
    cpu_raster_free(&first);
    display_list_free(&list);
}

fn rejection_contract(state: *TestState) void {
    let list: DisplayList = display_list_make();
    let shadow: DisplayOp = display_op(
        DisplayOpKind.fill_rounded_shadow, node_key(701));
    shadow.bounds = rect(0, 0, 20 * unit_scale(), 20 * unit_scale());
    shadow.parameter = 6 * unit_scale();
    shadow.paint.stroke_width = 0;
    expect(state, display_list_push(&list, shadow) ==
        DisplayError.invalid_parameter && list.ops.len == 0,
        "zero-blur shadow operations fail before display-list mutation");
    shadow.paint.stroke_width = 300 * unit_scale();
    expect(state, display_list_push(&list, shadow) ==
        DisplayError.invalid_parameter && list.ops.len == 0,
        "unbounded shadow support is rejected before raster work");
    display_list_free(&list);
}

fn main() i32 {
    let state: TestState = TestState{ .passed = 0, .failed = 0 };
    material_contract(&state);
    analytic_shadow_contract(&state);
    rejection_contract(&state);
    let passed: []u8 = _zag_i64_to_str(state.passed as i64);
    let failed: []u8 = _zag_i64_to_str(state.failed as i64);
    _zag_print("ZagKit v2 visual contract: pass="); _zag_print(passed);
    _zag_print(" fail="); _zag_println(failed);
    _zag_str_free(passed);
    _zag_str_free(failed);
    if (state.failed == 0) { return 0; }
    return 1;
}
